rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el estudio: Eric y Andoni
    function isTeam() {
      return request.auth != null
        && request.auth.token.email in ['ericruizmolero@savvia.studio', 'andoni@savvia.studio', 'ericruizmolero@treseiscero.app', 'andoni@treseiscero.app'];
    }

    // Presupuestos: lectura pública (enlace del cliente /client/…); escritura solo el estudio
    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if isTeam();
    }

    // Horas: lectura pública (vista del cliente /h/…); escritura solo el estudio
    match /timeProjects/{projectId} {
      allow read: if true;
      allow write: if isTeam();
    }
    match /timeEntries/{entryId} {
      allow read: if true;
      allow write: if isTeam();
    }

    // Empresa: la vista pública del presupuesto lee su ficha (logo, colores, fuentes) por id;
    // listar y escribir, solo el estudio
    match /companies/{companyId} {
      allow get: if true;
      allow list, write: if isTeam();
    }

    // Cuestionarios: el cliente abre su enlace (/cuestionario/<id>) y solo puede guardar sus respuestas;
    // nadie de fuera puede listarlos ni cambiar las preguntas
    match /questionnaires/{qid} {
      allow get: if true;
      allow list, create, delete: if isTeam();
      allow update: if isTeam() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'status', 'submittedAt', 'answeredAt'])
        && request.resource.data.answers is map
        && request.resource.data.status in ['pendiente', 'respondido']
      );
    }

    // Todo lo demás (tablón de proyectos, usuarios…): solo el estudio
    match /{document=**} {
      allow read, write: if isTeam();
    }
  }
}
